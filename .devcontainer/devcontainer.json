{
  "name": "second-brain (Expo)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",

  // Install dependencies once the Codespace is created.
  "postCreateCommand": "npm install",

  // Metro's default port. Tunnel mode (`npm run tunnel`) doesn't need this
  // forwarded, but it's handy for the web build / debugging.
  "forwardPorts": [8081],
  "portsAttributes": {
    "8081": { "label": "Expo / Metro" }
  },

  "customizations": {
    "vscode": {
      "extensions": ["expo.vscode-expo-tools", "dbaeumer.vscode-eslint", "esbenp.prettier-vscode"],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  }
}
